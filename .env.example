# Copie para .env.local (que o git ignora) e preencha. Na Vercel, as mesmas
# chaves vão em Settings → Environment Variables.

# ---- Formulário de contato (opcional) ----
# O formulário do site NÃO usa isto: ele abre o WhatsApp com a mensagem
# pronta, sem configuração nenhuma. A rota de e-mail continua no projeto para
# quem quiser trocar — veja "Formulário de contato" no README. Só então estas
# três importam.

# Chave da API da Resend: https://resend.com → API Keys → Create API Key.
# Nunca comite esse valor.
RESEND_API_KEY=

# Para onde as mensagens vão. Vazio usa o e-mail em src/lib/content.ts.
CONTACT_TO_EMAIL=

# Quem assina. Vazio usa o remetente de testes da Resend
# (onboarding@resend.dev), que só entrega na caixa dona da conta.
CONTACT_FROM_EMAIL=

# ---- Painel de visitas (/painel) ----
# Senha para entrar no painel. Sem ela o painel fica desligado.
PAINEL_SENHA=

# Banco das visitas (Upstash Redis). Na Vercel NÃO precisa preencher à mão:
# Storage → Create Database → Upstash for Redis → conectar ao projeto cria
# estas variáveis sozinho (às vezes com o prefixo KV_REST_API_, que também
# funciona). Preencha aqui só para testar o painel no seu computador.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Endereço do site ----
# Em produção não precisa: o padrão em src/lib/site.ts já é
# https://codaautomacoes.com. Defina só quando o site rodar em outro endereço
# — a prévia .vercel.app antes de o domínio apontar para lá, por exemplo —
# senão o canonical e as prévias do WhatsApp/LinkedIn saem apontando para o
# domínio de produção. Sem barra no fim.
NEXT_PUBLIC_SITE_URL=
