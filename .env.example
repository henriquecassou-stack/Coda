# Copie para .env.local (que o git ignora) e preencha. Na Vercel, as mesmas
# chaves vão em Settings → Environment Variables.

# ---- Formulário de contato (obrigatório para o formulário enviar) ----
# Chave da API da Resend: https://resend.com → API Keys → Create API Key.
# Sem ela o formulário responde "envio indisponível" em vez de fingir que
# enviou. Nunca comite esse valor.
RESEND_API_KEY=

# Para onde as mensagens vão. Se ficar vazio, usa o e-mail em src/lib/content.ts.
CONTACT_TO_EMAIL=

# Quem assina o e-mail. Vazio usa o remetente de testes da Resend
# (onboarding@resend.dev), que só entrega na caixa dona da conta — suficiente
# para começar. Com domínio próprio verificado na Resend, troque por algo como:
# CONTACT_FROM_EMAIL=CODA <contato@seudominio.com.br>
CONTACT_FROM_EMAIL=

# ---- Endereço do site ----
# Em produção não precisa: o padrão em src/lib/site.ts já é
# https://codaautomacoes.com. Defina só quando o site rodar em outro endereço
# — a prévia .vercel.app antes de o domínio apontar para lá, por exemplo —
# senão o canonical e as prévias do WhatsApp/LinkedIn saem apontando para o
# domínio de produção. Sem barra no fim.
NEXT_PUBLIC_SITE_URL=
